generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Setting {
  id    String @id @default("main")
  key   String @unique
  value String
}

// Stored Discord application credentials + branding + server config
model AppConfig {
  id              String  @id @default("main")
  // Discord Application
  clientId        String  @default("")
  clientSecret    String  @default("") // encrypted
  botToken        String  @default("") // encrypted
  // Target guild for verification / pull
  guildId         String  @default("")
  verifiedRoleId  String  @default("")
  // Branding for public verify page
  brandName       String  @default("PLUSRP")
  brandLogo       String  @default("")
  brandDescription String @default("Verify your Discord account to join the community.")
  accentColor     String  @default("#5865F2")
  // Scopes / grants
  requestEmail    Boolean @default(false)
  requestGuilds   Boolean @default(false)
  // Redirect success URL (optional)
  successRedirect String  @default("")
  updatedAt       DateTime @updatedAt
}

model Member {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  discriminator String   @default("0")
  globalName    String?
  avatar        String?
  email         String?
  accessToken   String   // encrypted
  refreshToken  String   // encrypted
  expiresAt     DateTime?
  scopes        String   @default("identify guilds.join")
  ip            String?
  verifiedAt    DateTime @default(now())
  lastPulledAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discordId])
  @@index([verifiedAt])
}
